# Safe demo defaults; no AWS credentials or real resources.
AWS_REGION=us-east-1
MOCK_MODE=true

# Required only when MOCK_MODE=false. Values: `terraform output` in infra/.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
DB_CLUSTER_ARN=
DB_SECRET_ARN=
DB_NAME=mcec2

# Required for live POST /servers; the existing launch template, not a new resource.
LAUNCH_TEMPLATE_ID=
MAX_SERVERS_PER_USER=1
MAX_SERVERS_TOTAL=3
