# Public Cognito client values for live mode (not needed in mock mode).
# Copy to .env.local and fill in from `terraform output` in infra/.

# terraform output cognito_issuer
VITE_COGNITO_AUTHORITY=
# terraform output cognito_client_id
VITE_COGNITO_CLIENT_ID=
# terraform output cognito_login_url
VITE_COGNITO_DOMAIN=
# Comma-separated server IDs (terraform output admin_server_id)
VITE_SERVER_IDS=
